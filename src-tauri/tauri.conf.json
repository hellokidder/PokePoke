{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokePoke",
  "version": "1.1.6",
  "identifier": "com.pokepoke.PokePoke",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    },
    "trayIcon": null
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5RDUzQUUxRDI3NTQ1NEEKUldSS1JYWFM0VHJWK1Q0RXlHZkVLVTBEYnJsc2l0ay9OSTYxMUh2cXFzRndzdW50Q2FwSjJhejQK",
      "endpoints": [
        "https://github.com/hellokidder/PokePoke/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Kidder Li (A883X5CDJA)",
      "providerShortName": "A883X5CDJA"
    },
    "resources": {
      "sounds/": "sounds/"
    }
  }
}
