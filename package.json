{
  "name": "poke-poke",
  "private": true,
  "license": "MIT",
  "version": "1.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run && node scripts/test-opencode-plugin.mjs && node scripts/test-pi-extension.mjs && node scripts/test-omp-extension.mjs && node scripts/test-dsh-plugin.mjs",
    "test:watch": "vitest",
    "test:plugin": "node scripts/test-opencode-plugin.mjs && node scripts/test-pi-extension.mjs && node scripts/test-omp-extension.mjs && node scripts/test-dsh-plugin.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "install:hook": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin pokehook && src-tauri/target/release/pokehook --deploy-self",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint:biome": "biome lint src"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.8.0",
    "radix-ui": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.4"
  }
}
